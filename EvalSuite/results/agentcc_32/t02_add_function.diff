 import unittest
-from textutil import title_case
+from textutil import title_case, slugify
 
 
 class T(unittest.TestCase):
     def test_title(self):
         self.assertEqual(title_case('a b'), 'A B')
+
+    def test_slugify(self):
+        self.assertEqual(
+            slugify('Hello,   World! -- Again'), 'hello-world-again'
+        )
+        # Hyphens stripped from both ends; all-punctuation input -> empty.
+        self.assertEqual(slugify('--Hello--World--'), 'hello-world')
+        self.assertEqual(slugify('!!!'), '')
+        # Already-slugged and plain input pass through unchanged.
+        self.assertEqual(slugify('hello-world'), 'hello-world')
+        self.assertEqual(
+            slugify('Total 100% of the 2 cases'), 'total-100-of-the-2-cases'
+        )
