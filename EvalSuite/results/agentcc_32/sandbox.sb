;; EvalSuite copy: the two account folder names are replaced as the public build replaces them; the rest is byte-identical to the run's profile.
(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
(deny file-write*)
