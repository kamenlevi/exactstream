+from textutil import slugify, title_case
 
 
 class T(unittest.TestCase):
     def test_title(self):
         self.assertEqual(title_case('a b'), 'A B')
+
+    def test_slugify_spaces(self):
+        self.assertEqual(
+            slugify('Hello, World! This is A TEST.'),
+            'hello-world-this-is-a-test',
+        )
+
+    def test_slugify_collapses_runs(self):
+        # A run of separators of any length becomes a single hyphen.
+        self.assertEqual(
+            slugify('foo  --__  bar/baz'),
+            'foo-bar-baz',
+        )
+
+    def test_slugify_strips_ends(self):
+        self.assertEqual(
+            slugify('--Hello World--'), 'hello-world'
+        )
+
+    def test_slugify_keeps_digits(self):
+        self.assertEqual(
+            slugify('ABC 123 def'), 'abc-123-def'
+        )
+
+    def test_slugify_all_separators(self):
+        # Everything collapses, then the hyphens are stripped -> empty.
+        self.assertEqual(
+            slugify('!!! ??? --'), ''
+        )
+
+    def test_slugify_empty(self):
+        self.assertEqual(
+            slugify(''), ''
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
