+import re
+
+
 def title_case(s):
     return ' '.join(w.capitalize() for w in s.split())
+
+
+def slugify(text):
+    """Lowercase `text` and collapse runs of non-alphanumeric chars to '-'.
+
+    Hyphens are stripped from both ends, so a leading/trailing run of
+    separators yields an empty string (e.g. 'Hello!' -> 'hello').
+    """
+    return re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')
