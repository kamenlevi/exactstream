(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
(deny file-write*)
(allow file-write* (subpath "/private/var/folders") (regex #"^/dev/"))
(deny file-read* (subpath "/Users/kamen/.ssh") (subpath "/Users/kamen/.aws") (subpath "/Users/kamen/.gnupg") (regex #"^/Users/[^/]+/\.claude[^/]*(/|$)")
  (subpath "/Users/kamen/.codex") (subpath "/Users/kamen/.config/gh") (literal "/Users/kamen/.netrc") (literal "/Users/kamen/.git-credentials")
  (subpath "/Users/kamen/Library/Keychains") (subpath "/Users/kamen/Library/Mail") (subpath "/Users/kamen/Library/Messages") (subpath "/Users/kamen/Library/Cookies")
  (subpath "/Users/kamen/Library/Safari") (subpath "/Users/kamen/Library/Application Support/Google") (subpath "/Users/kamen/Library/Application Support/Claude")
  (subpath "/Users/kamen/Documents") (subpath "/Users/kamen/Desktop") (subpath "/Users/kamen/Downloads") (subpath "/Users/kamen/Papers") (subpath "/Users/kamen/.local/share/exactstream-sessions"))
