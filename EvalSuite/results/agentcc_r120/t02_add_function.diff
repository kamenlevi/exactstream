+import re
+
+
 def title_case(s):
     return ' '.join(w.capitalize() for w in s.split())
+
+
+def slugify(text):
+    """Lowercase ``text``, collapse runs of non-alphanumeric chars into a
+    single hyphen, and strip hyphens from both ends."""
+    text = text.lower()
+    text = re.sub(r'[^a-z0-9]+', '-', text)
+    return text.strip('-')
