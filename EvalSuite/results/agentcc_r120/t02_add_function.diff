+    def test_slugify_lowercases_and_joins_words(self):
+        self.assertEqual(
+            slugify('Hello World Foo'), 'hello-world-foo',
+        )
+
+    def test_slugify_collapses_runs_of_non_alnum(self):
+        self.assertEqual(
+            slugify('Hello___World!!!Foo'), 'hello-world-foo',
+        )
+
+    def test_slugify_strips_hyphens_from_ends(self):
+        self.assertEqual(
+            slugify('--Hello World--'), 'hello-world',
+        )
+
