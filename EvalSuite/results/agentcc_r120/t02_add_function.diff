+        self.assertEqual(
+            slugify('Top 10 Tips 4 U'), 'top-10-tips-4-u',
+        )
+
+    def test_slugify_all_separator_text_gives_empty(self):
+        self.assertEqual(
+            slugify('!!!___---'), '',
+        )
+
+    def test_slugify_empty_string(self):
+        self.assertEqual(
+            slugify(''), '',
+        )
