+from textutil import slugify, title_case
 
 
 class T(unittest.TestCase):
     def test_title(self):
         self.assertEqual(title_case('a b'), 'A B')
+
+    def test_slugify_lowercases_and_joins_words(self):
+        self.assertEqual(
+            slugify('Hello, World! This is a TEST.'),
+            'hello-world-this-is-a-test',
+        )
+
+    def test_slugify_collapses_runs_to_single_hyphen(self):
+        self.assertEqual(
+            slugify('foo___bar--baz  qux'),
+            'foo-bar-baz-qux',
+        )
+
+    def test_slugify_strips_hyphens_from_ends(self):
+        self.assertEqual(
+            slugify('--leading and trailing--'),
+            'leading-and-trailing',
+        )
+
+    def test_slugify_keeps_digits(self):
+        self.assertEqual(
+            slugify('Version 2.5 Rocks!!'),
+            'version-2-5-rocks',
+        )
+
+    def test_slugify_all_separator_text_gives_empty(self):
+        self.assertEqual(
+            slugify('!!!___---'),
+            '',
+        )
+
+    def test_slugify_empty_string(self):
+        self.assertEqual(
+            slugify(''),
+            '',
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
