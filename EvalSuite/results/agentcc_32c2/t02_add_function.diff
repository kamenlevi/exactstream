+from textutil import slugify, title_case
 
 
 class T(unittest.TestCase):
     def test_title(self):
         self.assertEqual(title_case('a b'), 'A B')
+
+    def test_slugify_spaces_and_punctuation(self):
+        self.assertEqual(
+            slugify('Hello, World! This is a Test...'),
+            'hello-world-this-is-a-test',
+        )
+
+    def test_slugify_collapses_runs_to_single_hyphen(self):
+        self.assertEqual(
+            slugify('foo__bar--baz  qux'),
+            'foo-bar-baz-qux',
+        )
+
+    def test_slugify_strips_hyphens_from_ends(self):
+        self.assertEqual(
+            slugify('--already--sliced--'),
+            'already-sliced',
+        )
+
+    def test_slugify_keeps_digits(self):
+        self.assertEqual(
+            slugify('  HTTP 200 OK 200 '),
+            'http-200-ok-200',
+        )
+
+    def test_slugify_all_separator_text_returns_empty(self):
+        self.assertEqual(
+            slugify('!!! ??? ---'),
+            '',
+        )
+
+    def test_slugify_empty_string(self):
+        self.assertEqual(
+            slugify(''),
+            '',
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
