+import re
+
+
 def title_case(s):
     return ' '.join(w.capitalize() for w in s.split())
+
+
+def slugify(text):
+    """Lowercase the text, collapse runs of non-alphanumeric characters into
+    single hyphens, and strip hyphens from both ends."""
+    return re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')
