+from textutil import slugify, title_case
 
 
 class T(unittest.TestCase):
     def test_title(self):
         self.assertEqual(title_case('a b'), 'A B')
+
+    def test_slugify(self):
+        self.assertEqual(
+            slugify('Hello,   World!-- 123__go'), 'hello-world-123-go'
+        )
+
+    def test_slugify_strips_hyphens(self):
+        self.assertEqual(
+            slugify('!!!Hello, World!!!'), 'hello-world'
+        )
+
+    def test_slugify_all_separator(self):
+        self.assertEqual(
+            slugify('!!!'), ''
+        )
+
+    def test_slugify_empty(self):
+        self.assertEqual(
+            slugify(''), ''
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
