# 24 GB line = w13b, the configuration the 24 GB card gate passed (Tue 10 Nov 08:41; BigMoE data/stack/card_w24d_env.txt at
# blob e06f495e, its env line verbatim below). Pools: 141 base + 26 sidecar slots (14.87 GB); every check verifies at most
# 13 rows; QOM (optional expert uses served only when resident) on humaneval, mbpp and lcb6, exact expert reads elsewhere
# (IFBench, GPQA, chat); only the 4-bit DFlash2 drafter (R57_D7B=all). lossy-24 and chat-24 are this one gated configuration.
# Decode loop: engine/loop/r57_screen_w24.py (rel1's + R57_ROWCAP / R57_GATEREQ / U3W / R57_HARD; BigMoE 016cb7f).
# Memory label: under 24 GB on prompts up to about 560 tokens, up to 25.1 GB on longer ones (the gate: 22 of 40 processes
# crossed 24.0 GB, the shortest prompt at a first crossing 561 tokens). Unless BigMoE's W24e changes R57_PFCHUNK below.
SNAPSHOT=w24
C=100
BIGMOE_EXT_BUILD=build_qom,R57_REFTOK=,R57_FAST=QOM,R57_D17=1,R57_HC8=1,REF2_HC8_FAST=1,R57_DNR=1,R57_HCB=1,REF2_SMALL_NATIVE=1,R57_D7BNAX=1,REF2_OOO_1C=1,R57_NAX=1,REF2_NAX_1CQ=1,REF2_DN_KS=1,REF2_GDN_LAZY=1,D7BNAX_32=2,R57_FASTTAX=1,R57_SBN=2,R57_DSUB=1,R57_SVH=1,R57_RELAX_SPAN=1,R57_RELAX_SPAN_RULE=R2:2:0.25,R57_COPY=g2,REF2_KEEP_CACHES=1,R57_WIRED=1,BIGMOE_PAUSE_EVERY_MS=50,R57_S0CARRY=1,REF2_SB_FIRST=1,REF2_PLE_LATE=1,REF2_COMMIT_SUB=9,R57_DQ1=1,REF2_NAX_COH=1,R57_VTIER=,BIGMOE_TIER_CM=141,BIGMOE_TIER_CL=26,R57_ROWCAP=13,REF2_TIER_CHUNK=1,BIGMOE_TIER_PF_GROUP=64,R57_CACHE_GB=0.25,R57_D7B=all,R57_HARD=1200,R57_QOM_SETS=humaneval,mbpp,lcb6
# Prefill rows per chunk (the gate ran the default 1024; W24e decides 1024 / 512 / 256): one line to change.
R57_PFCHUNK=1024
