# exact-45: config E, exact (tokens bitwise equal to the exact reference NAX6-N), 45 GB line: C 256 expert slots per layer.
# Source: BigMoE scripts/pfd.sh, line E (snapshot pfd); runs pde0 (12 IFEval, CAP 64). Label and gate: README, Configs.
C=256
# Defensive pin (Leap 11-12, staged, not in 1.1.0): MTPLX's sparse QSA prefill lane off. A no-op in this engine, whose loop
# never sets MTPLX's 'prefill' attention phase (the lane's gate); it keeps exact dense if a later engine sets it.
R57_NAX=1,REF2_KEEP_CACHES=1,R57_WIRED=1,BIGMOE_PAUSE_EVERY_MS=50,R57_S0CARRY=1,REF2_SB_FIRST=1,REF2_PLE_LATE=1,REF2_COMMIT_SUB=9,R57_DQ1=1,MTPLX_QSA_PREFILL=0
