<?xml version="1.0" encoding="UTF-8"?>
<!-- Qwen 4 watcher as a LaunchAgent: one read-only pass of qwen4/watch.py every 5 minutes, surviving session restarts.
     NOT INSTALLED: it is persistent system configuration, so it needs Kamen's OK (via the orchestrator). To install:
       cp ~/MoonShots/qwen4/com.moonshots.qwen4watch.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.moonshots.qwen4watch.plist
     To remove: launchctl unload ~/Library/LaunchAgents/com.moonshots.qwen4watch.plist && rm that file. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.moonshots.qwen4watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/kamen/MoonShots/qwen4/watch.py</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/kamen/MoonShots/qwen4/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/kamen/MoonShots/qwen4/launchd.err</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
