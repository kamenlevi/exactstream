en its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    def has_positive_digit(n):\n        \"\"\"\n        Check if a number has a positive digit.\n        For negative numbers, the first signed digit is negative, but the next digits\n        are positive. We count the absolute value of the first non-zero digit.\n        \"\"\"\n        if n == 0:\n            return False\n        if n < 0:\n            # For negative numbers, the first signed digit is negative.\n            # We check if any of the remaining digits are positive.\n            # This is equivalent to checking if the absolute value of the number\n            # has a positive digit, except we need to be careful about the sign.\n            # Actually, the problem says \"first signed digit will be negative\".\n            # So for -123, the signed digits are -1, 2, 3.\n            # The first signed digit is -1, which is negative.\n            # The next signed digit is 2, which is positive.\n            # So -123 has a positive digit.\n            # For -11, the signed digits are -1, 1.\n            # The first signed digit is -1, which is negative.\n            # The next signed digit is 1, which is positive.\n            # So -11 has a positive digit.\n            # For -1, the signed digits are -1.\n            # The first signed digit is -1, which is negative.\n            # So -1 does not have a positive digit.\n            # For 123, the signed digits are 1, 2, 3.\n            # The first signed digit is 1, which is positive.\n            # So 123 has a positive digit.\n            # For -1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456